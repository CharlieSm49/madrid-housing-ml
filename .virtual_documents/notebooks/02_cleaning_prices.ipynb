


# Import the Pandas library for data manipulation and analysis
import pandas as pd

# Import NumPy for numerical operations
import numpy as np

# Import Matplotlib for creating basic charts and graphs
import matplotlib.pyplot as plt

# Import Seaborn for creating attractive statistical visualisations
import seaborn as sns 


# Loading Dataset 2: Average Declared Housing Price (euros/m2) by District and Neighborhood in Madrid
prices = pd.read_csv("../data/prices.csv", sep=";",skiprows=5)


# Create a clean working copy of dataset
prices_clean = prices.copy()


# Display the first five rows
prices_clean.head(10)


# Combine first two rows into header
new_columns = ( prices.columns.astype(str) + "_" +
                prices.iloc[1].fillna("").astype(str)+ ":_" +
                prices.iloc[0].fillna("").astype(str) )

prices_clean.columns= new_columns


# Drop first two rows by resetting the indexes
prices_clean = prices_clean.iloc[2:].reset_index(drop=True)


# Display the first five rows
prices_clean.head(10)


# Display the last 9 columns containing 2025 data

prices_clean.columns[-9:]


# Create a new DF with select columns
prices_clean_2025= prices_clean[["Unnamed: 0_:_","Unnamed: 1_:_",'2025_Total:_Euros/m2']]


prices_clean_2025.head(10)


# Rename columns 

column_mapper = {'Unnamed: 0_:_': 'district_name', 
                'Unnamed: 1_:_': 'neighbourhood_name',
                '2025_Total:_Euros/m2': 'mean_average_price_euros_per_m2',}

prices_clean_2025=prices_clean_2025.rename(mapper=column_mapper, axis=1)


# Display DF 
prices_clean_2025


# Count missing values
prices_clean_2025.isnull().sum()


# Display rows with missing values 
prices_clean_2025[prices_clean_2025.isnull().any(axis=1)]


# Display rows with mising values 
